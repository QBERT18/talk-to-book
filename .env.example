# Mongo connection string. Must point at a replica set (required by updateBookAction transactions).
# Examples:
#   Docker compose:  mongodb://mongo:27017/talk-to-book?replicaSet=rs0&directConnection=true
#   Local RS:        mongodb://localhost:27017/talk-to-book?replicaSet=rs0&directConnection=true
#   Atlas:           mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/talk-to-book
MONGODB_URI=
